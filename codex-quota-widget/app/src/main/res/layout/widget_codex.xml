<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="8dp"
    android:paddingTop="7dp"
    android:paddingEnd="8dp"
    android:paddingBottom="7dp">

    <ImageView
        android:layout_width="29dp"
        android:layout_height="29dp"
        android:contentDescription="Codex"
        android:src="@drawable/ic_codex" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="5dp"
        android:layout_weight="0.68"
        android:orientation="vertical">
        <TextView
            android:id="@+id/widget_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="CODEX"
            android:textColor="@color/codex_accent"
            android:textSize="10sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/widget_updated"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="—"
            android:textColor="@color/codex_muted"
            android:textSize="9sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_primary_card"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="4dp"
        android:layout_weight="1.25"
        android:background="@drawable/quota_card_background"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingTop="5dp"
        android:paddingEnd="8dp"
        android:paddingBottom="5dp">
        <TextView
            android:id="@+id/widget_primary_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="5h"
            android:textColor="@color/codex_muted"
            android:textSize="9sp" />
        <TextView
            android:id="@+id/widget_primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="—"
            android:textColor="@color/codex_text"
            android:textSize="15sp"
            android:textStyle="bold" />
        <ProgressBar
            android:id="@+id/widget_primary_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="3dp"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/quota_progress" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_secondary_card"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.25"
        android:background="@drawable/quota_card_background"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingTop="5dp"
        android:paddingEnd="8dp"
        android:paddingBottom="5dp">
        <TextView
            android:id="@+id/widget_secondary_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="Semaine"
            android:textColor="@color/codex_muted"
            android:textSize="9sp" />
        <TextView
            android:id="@+id/widget_secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="—"
            android:textColor="@color/codex_text"
            android:textSize="15sp"
            android:textStyle="bold" />
        <ProgressBar
            android:id="@+id/widget_secondary_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="3dp"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/quota_progress" />
    </LinearLayout>
</LinearLayout>
