<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="10dp"
    android:paddingTop="6dp"
    android:paddingEnd="10dp"
    android:paddingBottom="6dp">

    <ImageView
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:contentDescription="Codex"
        android:src="@drawable/ic_codex" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_weight="1.05"
        android:orientation="vertical">
        <TextView
            android:id="@+id/widget_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="CODEX"
            android:textColor="@color/codex_text"
            android:textSize="11sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/widget_updated"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="—"
            android:textColor="@color/codex_muted"
            android:textSize="8sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_primary"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.15"
        android:gravity="center"
        android:maxLines="2"
        android:text="5h\n—"
        android:textColor="@color/codex_text"
        android:textSize="10sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_secondary"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.15"
        android:gravity="center"
        android:maxLines="2"
        android:text="Semaine\n—"
        android:textColor="@color/codex_text"
        android:textSize="10sp"
        android:textStyle="bold" />
</LinearLayout>
