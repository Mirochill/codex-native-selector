<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/codex_background">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">
        <ImageView
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:layout_gravity="center_horizontal"
            android:contentDescription="Codex"
            android:src="@drawable/ic_codex" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="Codex Quota"
            android:textColor="@color/codex_text"
            android:textSize="24sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Widget 4×1 • léger et local"
            android:textColor="@color/codex_muted"
            android:textSize="13sp" />
        <TextView
            android:id="@+id/main_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:background="@drawable/quota_card_background"
            android:padding="16dp"
            android:textColor="@color/codex_text"
            android:textSize="15sp" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/quota_card_background"
            android:orientation="vertical"
            android:padding="14dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ACTUALISATION AUTOMATIQUE"
                android:textColor="@color/codex_muted_bright"
                android:textSize="11sp"
                android:textStyle="bold" />
            <Spinner
                android:id="@+id/main_interval"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="3dp"
                android:spinnerMode="dropdown" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Android peut légèrement décaler l’heure pour préserver la batterie."
                android:textColor="@color/codex_muted"
                android:textSize="11sp" />
        </LinearLayout>
        <Button
            android:id="@+id/main_sync"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Connecter ChatGPT / Codex" />
        <Button
            android:id="@+id/main_manual"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Renseigner les quotas manuellement" />
        <TextView
            android:id="@+id/main_privacy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="La connexion reste locale et chiffrée. L’actualisation automatique utilise uniquement Internet lorsque la batterie n’est pas faible. Un toucher force toujours une synchronisation silencieuse."
            android:textColor="@color/codex_muted"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
